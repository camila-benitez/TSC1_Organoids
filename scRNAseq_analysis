  gene          = up_map$ENTREZID,
  OrgDb         = org.Hs.eg.db,
  keyType       = "ENTREZID",
  ont           = "BP",
  pAdjustMethod = "BH",
  pvalueCutoff  = 0.05,
  qvalueCutoff  = 0.2,
  readable      = TRUE
)

ego_down <- enrichGO(
  gene          = down_map$ENTREZID,
  OrgDb         = org.Hs.eg.db,
  keyType       = "ENTREZID",
  ont           = "BP",
  pAdjustMethod = "BH",
  pvalueCutoff  = 0.05,
  qvalueCutoff  = 0.2,
  readable      = TRUE
)

#remove redundant terms
ego_up <- simplify(ego_up, cutoff = 0.7)
ego_down <- simplify(ego_down, cutoff = 0.7)

#remove terms that dont make sense for organoids
bad_terms <- c(
  "renal system development",
  "connective tissue development",
  "cartilage development",
  "epithelial tube morphogenesis",
  "muscle cell differentiation",
  "muscle cell development",
  "muscle",
  "muscle organ development",
  "heart morphogenesis",
  "gland development",
  "ear development",
  "ossification",
  "respiratory system development",
  "heart contraction",
  "regulation of blood circulation",
  "muscle contraction",
  "cardiac muscle cell action potential involved in contraction",
  "heart trabecula morphogenesis")

pattern <- paste(bad_terms, collapse = "|")

ego_down@result <- ego_down@result[
  !grepl(pattern, ego_down@result$Description, ignore.case = TRUE),
]
ego_up@result <- ego_up@result[
  !grepl(pattern, ego_up@result$Description, ignore.case = TRUE),
]



#plot
