#Harmony integration
```{r}
#Integration
#create a list
obj.list <- list(
  WT_4M = WT.4M.obj2,
  B2_4M = B2.4M.obj2,
  C10_4M = C10.4M.obj2,
  WT_6M = WT.6M.obj2,
  B2_6M = B2.6M.obj2,
  C10_6M = C10.6M.obj2
)

#select integration features
features <- SelectIntegrationFeatures(object.list = obj.list, nfeatures = 3000)
length(features)   # sanity check

#merge
combined <- merge(
  x = obj.list[[1]],
  y = obj.list[-1],
  add.cell.ids = names(obj.list),
  project = "scRNA_HET_WT"
)

#Set the variable features of the merged object to the selected integration features
VariableFeatures(combined) <- features
#PCA
combined <- RunPCA(
  combined,
  assay = "SCT",
  npcs = 50,
  verbose = FALSE
)

#harmony integration
combined <- RunHarmony(
  combined,
  group.by.vars = "sample",
  assay.use = "SCT",
)

#UMAP and Clustering
combined <- RunUMAP(
  combined,
  reduction = "harmony",
  dims = 1:30
)

#Save RunUMAP object list

combined <- FindNeighbors(
  combined,
  reduction = "harmony",
  dims = 1:30
)

combined <- FindClusters(combined, resolution = 0.4)

#DimPlot(combined, group.by = c("sample", "genotype", "timepoint_geno"))
#DimPlot(combined, group.by = "seurat_clusters")
#print(table(combined$sample))

#save integrated object
saveRDS(combined, file = "mar2026_int_obj.rds")
combined <- readRDS(file ="mar2026_int_obj.rds")
```

