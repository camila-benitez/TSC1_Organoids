  glut,
  group.by = c("sample", "genotype"),
  return.seurat = TRUE
)

#get counts
counts <- pb[["RNA"]]$counts
meta <- pb@meta.data

#run edgeR
library(edgeR)

dge <- DGEList(counts = counts)
dge <- calcNormFactors(dge)

meta$genotype <- relevel(factor(meta$genotype), ref = "WT")
design <- model.matrix(~ genotype, data = meta)



dge <- estimateDisp(dge, design)
fit <- glmQLFit(dge, design)

qlf <- glmQLFTest(fit, coef = "genotypeHet")

res <- topTags(qlf, n = Inf)$table

#add gene names
res$gene <- rownames(res)

#save the DEG list
#write.csv(res, file = "glutamatergic_DEGs.csv")

#filter for significantly changed genes
sig <- res %>%
  filter(abs(logFC) > 0.5, FDR < 0.1)



#filter for up and down
res_up <- sig %>%
  filter(FDR < 0.1, logFC > 0.5)

res_down <- sig %>%
  filter(FDR < 0.1, logFC < -0.5)


#convert to ENTREZIDs
up_map <- bitr(res_up$gene,
               fromType = "SYMBOL",
               toType = "ENTREZID",
               OrgDb = org.Hs.eg.db)

down_map <- bitr(res_down$gene,
                 fromType = "SYMBOL",
                 toType = "ENTREZID",
                 OrgDb = org.Hs.eg.db)

