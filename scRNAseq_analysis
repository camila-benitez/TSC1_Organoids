# exact permutation test for 2-group comparison with small n
perm_test <- function(x, g) {
  g <- as.character(g)
  obs <- mean(x[g == "Het"]) - mean(x[g == "WT"])

  n_wt <- sum(g == "WT")
  idx <- seq_along(x)
  combs <- combn(idx, n_wt, simplify = FALSE)

  null_diffs <- vapply(combs, function(wt_idx) {
    het_idx <- setdiff(idx, wt_idx)
    mean(x[het_idx]) - mean(x[wt_idx])
  }, numeric(1))

  p <- mean(abs(null_diffs) >= abs(obs))
  c(diff = obs, p.value = p)
}

stats_df <- plot_df %>%
  group_by(cell_type) %>%
  group_modify(~{
    res <- perm_test(.x$prop, .x$genotype)
    tibble(
      diff = as.numeric(res["diff"]),
      p.value = as.numeric(res["p.value"]),
      y = max(.x$prop, na.rm = TRUE)
    )
  }) %>%
  ungroup() %>%
  mutate(
    p.adj = p.adjust(p.value, method = "BH"),
    label = paste0("Δ=", signif(diff, 2), "\nFDR=", signif(p.adj, 2))
  )

