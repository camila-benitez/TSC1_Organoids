```{r}
library(dplyr)
library(tibble)
library(pheatmap)

library(dplyr)
library(tibble)
library(pheatmap)

# RNA table
rna_df <- seq %>%
  dplyr::select(geneSym = gene, logFC_rna = logFC, FDR)

# Protein table
prot_df <- proteomics_clean %>%
  dplyr::select(geneSym, logFC_prot = log2FC, pvalue)

# Merge
combined_df <- inner_join(rna_df, prot_df, by = "geneSym") %>%
  dplyr::filter(!is.na(logFC_rna), !is.na(logFC_prot)) %>%
  dplyr::distinct(geneSym, .keep_all = TRUE)

# Keep only stronger changes
filtered_df <- combined_df %>%
  dplyr::filter(abs(logFC_rna) >= 0.5 | abs(logFC_prot) >= 0.5)

# Create concordance category
filtered_df <- filtered_df %>%
  dplyr::mutate(
    concordance = case_when(
      logFC_rna > 0 & logFC_prot > 0 ~ "Up/Up",
      logFC_rna < 0 & logFC_prot < 0 ~ "Down/Down",
      logFC_rna > 0 & logFC_prot < 0 ~ "RNA Up / Prot Down",
      logFC_rna < 0 & logFC_prot > 0 ~ "RNA Down / Prot Up",
      TRUE ~ "Other"
    )
  )

# Matrix for clustering
mat <- filtered_df %>%
  dplyr::select(geneSym, logFC_rna, logFC_prot) %>%
  tibble::column_to_rownames("geneSym") %>%
  as.matrix()

# Scale rows so each gene is centered across RNA/protein
mat_scaled <- t(scale(t(mat)))

# Hierarchical clustering
hc <- hclust(dist(mat_scaled), method = "ward.D2")

# Force a chosen number of clusters
k <- 4
cluster_id <- cutree(hc, k = k)

# Add cluster labels back to dataframe
filtered_df$cluster <- cluster_id[filtered_df$geneSym]

# Row annotation for heatmap
anno_row <- filtered_df %>%
  dplyr::select(geneSym, cluster, concordance) %>%
  dplyr::distinct() %>%
  tibble::column_to_rownames("geneSym")

# Heatmap
pheatmap(
  mat_scaled,
  color = colorRampPalette(c("blue", "white", "red"))(100),
  cluster_rows = hc,
  cluster_cols = TRUE,
  clustering_method = "ward.D2",
  show_rownames = FALSE,
  annotation_row = anno_row,
  cutree_rows = k,
  main = "RNA vs protein hierarchical clustering"
)

