#compare to ASD gene sets
```{r}
#import SFARI ASD associated gene list
sfari <- read.csv("SFARI-Gene_genes.csv")

# keep high-confidence genes (recommended)
sfari_genes <- sfari %>%
  dplyr::filter(gene.score %in% c(1, 2, 3)) %>%   # 1–3 = strongest evidence
  dplyr::pull(gene.symbol) %>%
  unique()

#define my gene list: all significant genes
your_genes <- df_plot %>%
  dplyr::filter(significance != "NS") %>%
  dplyr::pull(geneSym) %>%
  unique()

# background = all measured genes with gene symbols
background <- df_plot %>%
  dplyr::filter(!is.na(geneSym)) %>%
  dplyr::pull(geneSym) %>%
  unique()

# keep only SFARI genes that are actually present in the background
sfari_genes <- intersect(sfari_genes, background)

# overlap counts
overlap <- length(intersect(your_genes, sfari_genes))
your_only <- length(setdiff(your_genes, sfari_genes))
sfari_only <- length(setdiff(sfari_genes, your_genes))
neither <- length(setdiff(background, union(your_genes, sfari_genes)))

# contingency table
mat <- matrix(c(overlap, your_only,
                sfari_only, neither),
              nrow = 2,
              byrow = TRUE)

# Fisher's exact test
fisher.test(mat)


```

