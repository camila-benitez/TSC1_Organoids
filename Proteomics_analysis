#Go term labels on plot
```{r}
#annotate dataset
df_plot <- proteomics_clean %>%
  mutate(
    negLog10Padj = -log10(adj.pvalue),

    significance = case_when(
      adj.pvalue < padj_cutoff & log2FC >=  log2FC_cutoff ~ "Up",
      adj.pvalue < padj_cutoff & log2FC <= -log2FC_cutoff ~ "Down",
      TRUE ~ "NS"
    ),

    category = case_when(
      geneSym %in% presynaptic   ~ "Presynaptic",
      geneSym %in% cathepsins    ~ "Cathepsins",
      geneSym %in% mTOR          ~ "mTOR",
      geneSym %in% Neurodegeneration     ~ "Neurodegeneration",
      geneSym %in% interneuron   ~ "Interneuron",
      geneSym %in% glutamatergic ~ "Glutamatergic",
      TRUE ~ "Other"))

```

#force some labels
```{r}
#select which to label
forced_genes <- c("MAPT", "TARDBP")

top_labels <- df_plot %>%
  filter(category != "Other", significance != "NS") %>%
  group_by(category) %>%
  arrange(adj.pvalue, desc(abs(log2FC))) %>%
  slice_head(n = 5) %>%
  ungroup()

forced_labels <- df_plot %>%
  filter(geneSym %in% forced_genes)

label_df <- bind_rows(top_labels, forced_labels) %>%
  distinct(geneSym, .keep_all = TRUE)

