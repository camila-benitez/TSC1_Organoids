#volcano plot
```{r}
p1 <- ggplot(df_plot, aes(x = log2FC, y = negLog10Padj)) +

  ## background points
  geom_point(
  aes(color = significance),
  alpha = 0.7,
  size = 1.5,
  show.legend = FALSE
) +

  ## category overlay
  geom_point(
    data = df_plot %>% filter(category != "Other"),
    aes(color = category),
    size = 2.5
  ) +

  ## cutoff lines
  geom_vline(xintercept = c(-log2FC_cutoff, log2FC_cutoff),
             linetype = "dashed", color = "black") +
  geom_hline(yintercept = -log10(padj_cutoff),
             linetype = "dashed", color = "black") +

  ## top gene labels
  geom_text_repel(
  data = label_df,
  aes(label = geneSym, color = category),
  size = 4,
  fontface = "bold",
  max.overlaps = Inf,
  box.padding = 0.5,      # space around label
  point.padding = 0.5,    # space around the dot
  segment.color = "black",# color of the line connecting label to dot
  segment.size = 0.5,     # thickness of the line
  segment.alpha = 0.8,    # slightly transparent
  arrow = arrow(length = unit(0.015, "npc")), # optional arrowhead
  min.segment.length = 0, # draw line even for short distances
  show.legend = FALSE
) +

  ## scales
  scale_color_manual(
  values = c(sig_colors, category_colors),
  breaks = c("Presynaptic","Cathepsins","mTOR",
             "Neurodegeneration","Interneuron","Glutamatergic"),
  name = NULL) +

  ## theme
  theme_classic(base_size = 14) +
  labs(
    x = "log2 Fold Change",
    y = "-log10 adjusted p-value",
    title = "DA Proteins in TSC1 +/- v. TSC1 +/+")

